# ============================================================
# 建筑工程AI投标视频平台 — 环境配置示例
# 复制为 .env 后按需修改。严禁将真实 Key 提交到代码仓库。
# ============================================================

# ---------- 应用 ----------
APP_NAME=建筑工程AI投标视频平台
APP_ENV=development
DEBUG=true
SECRET_KEY=please-change-me-to-a-long-random-string
AUTH_COOKIE_SECURE=false       # HTTPS 生产环境必须改为 true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- 数据库 ----------
# Docker Compose 默认使用 Postgres；交付测试可改为 SQLite 快照：
DATABASE_URL=postgresql+psycopg://fastvideo:fastvideo@localhost:5432/fastvideo
# DATABASE_URL=sqlite:///./app.db
# DELIVERY_SQLITE_DB=./backend/app.db
# Docker Compose credentials (use unique values outside local demos)
POSTGRES_PASSWORD=change-this-postgres-password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0
# 本地无 Redis 时设为 false，任务将同步执行：
USE_CELERY=true
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TRACK_STARTED=true

# ---------- 文件存储（本地 + MinIO 兼容） ----------
STORAGE_BACKEND=local          # local | minio
STORAGE_LOCAL_DIR=./data/storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=fastvideo
MINIO_SECRET_KEY=change-this-minio-password
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=fastvideo
MINIO_SECURE=false

# ---------- FFmpeg ----------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# M4/M系列 Mac 推荐安装 rife-metal；选择 RIFE 时不可用会明确失败，不静默降级
RIFE_BINARY=rife-metal
RIFE_MODEL=
RIFE_TIER=hq
RIFE_TIMEOUT=900
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# ---------- AI 服务（全部支持 Adapter + Mock） ----------
# 本项目推荐组合：Kimi（文本结构化+多模态）+ Seedream 4.5（图生图）+ Seedance 2.0 标准档（图生视频）。
# Key 留空时对应模块自动回退 Mock，严禁将真实 Key 提交到仓库。
AI_LLM_PROVIDER=kimi
AI_LLM_BASE_URL=
AI_LLM_MODEL=kimi-k3

# 提示词大师与文本结构化环节统一使用 Kimi；Kimi 模型支持文字与图片输入
AI_PROMPT_MASTER_PROVIDER=kimi
AI_PROMPT_MASTER_MODEL=kimi-k3

AI_IMAGE_PROVIDER=seedream
AI_IMAGE_BASE_URL=
AI_IMAGE_MODEL=doubao-seedream-4-5-251128
AI_IMAGE_SIZE=1792x1024

# 视频生成默认使用 Seedance（火山方舟 Ark）。MiniMax 代码保留但不再是默认 Provider。
AI_VIDEO_PROVIDER=seedance
AI_VIDEO_BASE_URL=
AI_VIDEO_MODEL=doubao-seedance-2-0-260128

AI_TTS_PROVIDER=disabled       # volcengine（火山豆包语音）| openai | disabled(mock)
AI_TTS_BASE_URL=
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=onyx

# 火山引擎豆包语音合成（火山语音技术，openspeech.bytedance.com）
# 需在火山引擎控制台「语音技术 → API Key 管理」创建语音合成专用 API Key（与方舟 Ark Key 不同）
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_VOICE=zh_female_xiaohe_uranus_bigtts
VOLCENGINE_TTS_TIMEOUT=120

# DeepSeek（历史兼容配置，当前默认环节不再使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=120

# Kimi 文本+多模态（OpenAI 兼容接口）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
KIMI_TIMEOUT=180

# Kimi Code 编程版（sk-kimi- 开头的 Key，独立通道，与 Moonshot 平台 Key 分开存放）
KIMI_CODE_API_KEY=
KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
KIMI_CODE_MODEL=kimi-k3

# MiniMax：国内账号用 minimaxi.com；海外账号改为 https://api.minimax.io
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_TIMEOUT=180
# 视频模型（V2 接口，Hailuo-03）
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_RESOLUTION=1080P
MINIMAX_VIDEO_POLL_INTERVAL=10
MINIMAX_VIDEO_TIMEOUT=900

# Seedance（火山方舟 Ark 视频生成）· Seedream（图生图）：模型名、基础地址必须可配置
# 所有火山方舟模型可以共用这一枚 API Key；也可继续使用 SEEDANCE_API_KEY。
ARK_API_KEY=
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_VIDEO_MODEL=doubao-seedance-2-0-260128
SEEDANCE_TIMEOUT=180
SEEDANCE_POLL_INTERVAL=10
SEEDANCE_VIDEO_TIMEOUT=900
SEEDANCE_VIDEO_RESOLUTION=720p

# 火山方舟视觉模型（历史兼容配置，当前提示词大师默认不再使用）
# 未填写时复用 ARK_API_KEY / SEEDANCE_API_KEY
VOLCENGINE_VISION_API_KEY=
VOLCENGINE_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_VISION_MODEL=doubao-seed-2-0-lite-260215
VOLCENGINE_VISION_TIMEOUT=180

# Seedream 图生图：API Key 可复用上面的 SEEDANCE_API_KEY
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_IMAGE_MODEL=doubao-seedream-4-5-251128
SEEDREAM_TIMEOUT=180
SEEDREAM_IMAGE_SIZE=2K

# OpenAI（仅在 Provider 选择 openai 时使用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=120

# ---------- 管理员账号（首次启动自动创建） ----------
ADMIN_EMAIL=admin@fastvideo.cn
ADMIN_PASSWORD=admin123456
ALLOW_PUBLIC_REGISTRATION=true  # 生产环境必须改为 false
# 生产环境必须替换 SECRET_KEY、ADMIN_PASSWORD，并设置 APP_ENV=production、DEBUG=false、AUTH_COOKIE_SECURE=true。
